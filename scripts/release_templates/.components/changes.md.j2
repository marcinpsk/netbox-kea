{%- import "macros.md.j2" as formatting -%}
{%- set max_line_width = max_line_width | default(100) -%}
{%- set hanging_indent = hanging_indent | default(2) -%}
{%- for category, commits in commit_objects if category != "unknown" -%}
  {%- set ordered = namespace(commits=commits) -%}
  {%- set _ = formatting.apply_alphabetical_ordering_by_descriptions(ordered) -%}
  {%- set descriptions = [] -%}
  {%- for commit in ordered.commits -%}
    {%- set line = "- " ~ formatting.format_commit_summary_line(commit) -%}
    {%- set _ = descriptions.append(line | autofit_text_width(max_line_width, hanging_indent)) -%}
  {%- endfor -%}
  {%- if descriptions -%}
    {{- "\n### %s\n\n%s\n" | format(category | title, descriptions | unique | join("\n\n")) -}}
  {%- endif -%}
{%- endfor -%}
{#- Flatten the complete category lists; selecting 1.0 loses every later commit. -#}
{%- set commits = commit_objects | map(attribute="1") | sum(start=[]) | rejectattr("error", "defined") | list -%}
{%- for heading, selected, order, describe in (
  ("Breaking Changes", commits | selectattr("breaking_descriptions.0") | list,
    formatting.apply_alphabetical_ordering_by_brk_descriptions, formatting.format_breaking_changes_description),
  ("Additional Release Information", commits | selectattr("release_notices.0") | list,
    formatting.apply_alphabetical_ordering_by_release_notices, formatting.format_release_notice)
) -%}
  {%- if selected -%}
    {%- set ordered = namespace(commits=selected) -%}
    {%- set _ = order(ordered) -%}
    {%- set descriptions = [] -%}
    {%- for commit in ordered.commits -%}
      {%- set text = "- " ~ (describe(commit).split("\n\n") | join("\n\n- ")) -%}
      {%- set _ = descriptions.append(text | autofit_text_width(max_line_width, hanging_indent)) -%}
    {%- endfor -%}
    {{- "\n### %s\n\n%s\n" | format(heading, descriptions | unique | join("\n\n")) -}}
  {%- endif -%}
{%- endfor -%}
